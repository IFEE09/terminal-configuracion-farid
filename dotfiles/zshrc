export PATH="$HOME/.local/bin:$PATH"

# Claude Code: guardar siempre el historial de sesiones (para retomar con claude --continue)
export CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1

# Tema visual: solo en la Terminal de Mac (las demás terminales quedan como vienen)
if [[ "$TERM_PROGRAM" == "Apple_Terminal" && -o interactive ]]; then
  BREW="${HOMEBREW_PREFIX:-/opt/homebrew}"

  # Instant prompt de Powerlevel10k
  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi

  # Colores del ls de Mac (mismo comando, solo color)
  export CLICOLOR=1
  export LSCOLORS=ExGxFxdaCxDaDahbadeche

  source "$BREW/share/powerlevel10k/powerlevel10k.zsh-theme"
  [[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

  # Sugerencias en gris y colores de sintaxis
  source "$BREW/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  source "$BREW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"  # siempre al final
fi

# Bolita de color por pestaña (solo Terminal de Mac): cada pestaña nueva toma el
# siguiente color y lo antepone a su título, incluso al título que pone Claude Code
# (vía ~/.local/bin/bolita-titulo.py). Para quitarlo, borrar este bloque.
if [[ "$TERM_PROGRAM" == "Apple_Terminal" && -o interactive ]]; then
  if [[ -z "$TAB_BOLITA" ]]; then
    _bolitas=(🔴 🟠 🟡 🟢 🔵 🟣 🟤 ⚪ ⚫)
    # Fondo levemente teñido del color de la bolita (RGB de 16 bits; el alfa lo pone el perfil)
    _tintes=("8178,4363,6269" "8710,6629,4974" "8919,7994,6732" "5842,7393,6755" "5033,7277,10201" "6999,6583,9646" "7531,5727,6524" "8387,8642,10063" "5148,5519,7241")
    _f=~/.cache/bolita-pestana; mkdir -p ~/.cache
    _n=$(( ( $(cat $_f 2>/dev/null || echo 0) % ${#_bolitas} ) + 1 ))
    echo $_n > $_f
    export TAB_BOLITA=${_bolitas[$_n]} TAB_TINTE=${_tintes[$_n]}
    unset _bolitas _tintes _f _n
  fi
  # Pinta el fondo de esta pestaña (la que tiene este tty), en segundo plano para no frenar el arranque
  [[ -n "$TAB_TINTE" ]] && ( osascript -e "tell application \"Terminal\" to repeat with w in windows
    repeat with t in tabs of w
      if tty of t is \"$TTY\" then set background color of t to {$TAB_TINTE}
    end repeat
  end repeat" >/dev/null 2>&1 & ) 2>/dev/null
  _bolita_precmd() { print -Pn "\e]1;${TAB_BOLITA}\a" }
  autoload -Uz add-zsh-hook && add-zsh-hook precmd _bolita_precmd
  claude() {
    if [[ -t 0 && -t 1 ]]; then
      /usr/bin/python3 -I ~/.local/bin/bolita-titulo.py "$TAB_BOLITA " command claude "$@"
    else
      command claude "$@"
    fi
  }
fi
